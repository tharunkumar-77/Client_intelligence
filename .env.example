# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ── Database (matches docker-compose.yml defaults) ─────────────────────────────
DATABASE_URL=postgresql://ci_user:my_secure_password@localhost:5432/client_intelligence
CI_PASSWORD=my_secure_password

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-pro

# ── Google Sheets sync ─────────────────────────────────────────────────────────
# Paste the full content of your service account JSON key as a single line here.
# Instructions: docs/google_cloud_setup.md
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=

# ── Webhook security (shared secret between Apps Script and Flask) ─────────────
# Leave blank during local dev (signature check is skipped when empty).
INTAKE_WEBHOOK_SECRET=

# ── Vertical ───────────────────────────────────────────────────────────────────
DEFAULT_VERTICAL=financial_advisory
